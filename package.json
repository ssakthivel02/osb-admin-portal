{
  "name": "osb-admin-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "check:public-env": "node scripts/check-public-env-policy.mjs",
    "check:siddhar-evidence": "node scripts/check-siddhar-evidence-manifest.mjs",
    "check:siddhar-submissions": "node scripts/check-siddhar-evidence-submissions.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=quality-evidence/junit.xml",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.7.0",
    "jsdom": "29.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
